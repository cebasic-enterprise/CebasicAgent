# /opt/litellm/.env en el droplet (chmod 600). Nunca subir al repo.
# Dominio con registro A a la IP del droplet, o <ip-con-guiones>.sslip.io
LITELLM_DOMAIN=
OPENROUTER_API_KEY=
# openssl rand -hex 32 (el master key debe empezar con sk-)
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
LITELLM_DB_PASSWORD=
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=
