# CeBasic Agent — LiteLLM Proxy en Heroku (app cebasic-litellm, stack container).
#
# Misma imagen que docker-compose.override.yml (main-stable, LiteLLM 1.110.2),
# fijada por digest para que el deploy sea reproducible. Para actualizar,
# cambia el digest (docker image inspect ... --format '{{json .RepoDigests}}').
#
# Deploy (desde la carpeta litellm/, ver README-CEBASIC.md):
#   docker buildx build --platform linux/amd64 -f Dockerfile.heroku \
#     -t registry.heroku.com/cebasic-litellm/web --push .
#   heroku container:release web -a cebasic-litellm
FROM docker.litellm.ai/berriai/litellm@sha256:ef798594ca3db8d81bad2e1439f536f49b71fe095ee9f20416f5e149b4e22035

COPY config.yaml /app/config.yaml
COPY heroku-start.sh /app/heroku-start.sh

# Heroku asigna $PORT y exige SSL en Postgres: lo resuelve heroku-start.sh.
# Un solo worker para caber en un dyno Basic.
ENTRYPOINT []
CMD /app/heroku-start.sh
